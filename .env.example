# Frontend API Bağlantısı (Canlı ortamda Render.com backend URL'i)
VITE_API_URL=https://ozdersatranc.onrender.com

# Brevo (Sendinblue) HTTPS API (Render.com port engelini aşmak için ZORUNLU)
# app.brevo.com -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=ozderahmetcode@gmail.com
BREVO_SENDER_NAME="OZDER Satranç Topluluğu"

# Opsiyonel: Google Apps Script Webhook URL
# GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Yerel Doğrudan Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ozderahmetcode@gmail.com
SMTP_PASS=
SMTP_FROM="OZDER Satranç Topluluğu" <ozderahmetcode@gmail.com>
